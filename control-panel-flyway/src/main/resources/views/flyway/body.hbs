{{#with controlPanel.body }}
    {{#each schemas as |schema|}}
        <p class="card-text">
            <code>{{schema.name}}</code>
            <span class="badge {{schema.badgeClass}}">{{schema.summary}}</span>
            {{#if schema.currentVersion}}<span class="card-description">version {{schema.currentVersion}}</span>{{/if}}
        </p>
    {{else}}
        <p class="card-text card-description">No Flyway configurations.</p>
    {{/each}}
{{/with}}
