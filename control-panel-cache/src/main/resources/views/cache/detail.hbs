{{#with controlPanel.body }}

    <p class="card-text">
    <dl class="row">
        <dt class="col-sm-2">Implementation Class</dt>
        <dd class="col-sm-10"><code>{{ cacheInfo.get.implementationClass }}</code></dd>
        {{#each cacheInfo.get.caffeine }}
            <dt class="col-sm-2">{{ titleize (decamelize @key) }}</dt>
            <dd class="col-sm-10"><code>{{this}}</code></dd>
        {{/each}}
    </dl>

    <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#uploadModal">
        <i class="fa fa-trash"></i>
        Invalidate all
    </button>

    </p>

    {{#if cacheAsMap }}
        <p class="card-text">
        <table class="table">
            <thead>
            <tr>
                <th>Key</th>
                <th>Value</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {{#each cacheAsMap }}
                <tr>
                    <td><code>{{ @key }}</code></td>
                    <td>
                        {{ this }}
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#deleteConfirmModal" data-key="{{entry.key}}">
                            <i class="fa fa-trash"></i>
                            Invalidate
                        </button>
                    </td>
                </tr>
            {{/each}}
            </tbody>
        </table>
        </p>

        <div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteConfirmModalLabel">Confirm deletion</h5>
                    </div>
                    <div class="modal-body">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="deleteConfirm">Delete</button>
                    </div>
                    <input type="hidden" id="fileKey"/>
                </div>
            </div>
        </div>
    {{/if}}


    <div class="modal fade" id="uploadModal" tabindex="-1" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="uploadModalLabel">Upload file</h5>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <form id="uploadForm" enctype="multipart/form-data" action="{{ ext.appPath }}/object-storage-control-panel-controller/{{ controlPanel.title }}">
                            <label for="fileUpload" class="col-form-label">File:</label>
                            <input type="file" name="fileUpload">
                        </form>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="upload">Upload</button>
                </div>
            </div>
        </div>
    </div>

    <script>

        $('#upload').click(function(e){
            var form = $('#uploadForm')[0]
            var formData = new FormData(form)

            $.ajax({
                url: form.action, // Uses the action attribute from your form
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    $('#uploadModal').modal('hide')
                    globalAlertMessageReload('Success', 'File uploaded successfully', 'alert-success', 'fa-check')
                },
                error: function(xhr, status, error) {
                    $('#uploadModal').modal('hide')
                    globalAlertMessageDisplay('Error', error, 'alert-danger', 'fa-circle-exclamation')
                }
            });
        })

        $('#deleteConfirmModal').on('show.bs.modal', function (event) {
            var modal = $(this)
            var button = $(event.relatedTarget) // Button that triggered the modal
            var key = button.data('key') // Extract info from data-* attributes
            var body = "Are you sure you want to delete the file " + key + "?"
            modal.find('.modal-body').html('<p class="card-text">' + body + '</p>')
            $('#fileKey').val(key)
        })

        $('#deleteConfirm').click(function(event) {
            var fileKey = $('#fileKey').val();
            $.ajax({
                url: '{{ ext.appPath }}/object-storage-control-panel-controller/{{ controlPanel.title }}/' + fileKey,
                type: 'DELETE',
                contentType: "application/json; charset=utf-8",
                success: function(result) {
                    $('#deleteConfirmModal').modal('hide')
                    $('#fileKey').val('')
                    globalAlertMessageReload("Success", "File " + fileKey + " deleted successfully", "alert-success", "fa-check")
                },
                error: function(xhr, status, error) {
                    $('#deleteConfirmModal').modal('hide')
                    globalAlertMessageDisplay('Error', error, 'alert-danger', 'fa-circle-exclamation')
                }
            });
        })

        function download(objectStorageName, fileKey) {
            $.ajax({
                url: '{{ ext.appPath }}/object-storage-control-panel-controller/' + objectStorageName + '/' + fileKey,
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                xhrFields: {
                    responseType: 'blob'
                },
                success: function(data) {
                    var url = window.URL.createObjectURL(data);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = fileKey; // desired file name
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                },
                error: function(xhr, status, error) {
                    globalAlertMessageDisplay('Error', error, 'alert-danger', 'fa-circle-exclamation')
                }
            });
        }
    </script>
{{/with}}
