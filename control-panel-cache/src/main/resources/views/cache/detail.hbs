{{#with controlPanel.body }}

    <p class="card-text">
    <dl class="row">
        <dt class="col-sm-2">Implementation Class</dt>
        <dd class="col-sm-10"><code>{{ cacheInfo.get.implementationClass }}</code></dd>
        {{#each cacheInfo.get.caffeine }}
            <dt class="col-sm-2">{{ titleize (decamelize @key) }}</dt>
            <dd class="col-sm-10"><code>{{this}}</code></dd>
        {{/each}}
    </dl>

    </p>

    {{#not cacheAsMap.empty }}
        <p class="card-text">
            <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#invalidateAllConfirmModal">
                <i class="fa fa-trash"></i>
                Invalidate all keys
            </button>
        </p>
        <p class="card-text">
        <table class="table">
            <thead>
            <tr>
                <th>Key</th>
                <th>Value</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {{#each cacheAsMap }}
                <tr>
                    <td><code>{{ @key }}</code></td>
                    <td>
                        {{ this }}
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#invalidateConfirmModal" data-key="{{ @key }}">
                            <i class="fa fa-trash"></i>
                            Invalidate
                        </button>
                    </td>
                </tr>
            {{/each}}
            </tbody>
        </table>
        </p>

        <div class="modal fade" id="invalidateAllConfirmModal" tabindex="-1" role="dialog" aria-labelledby="invalidateAllConfirmModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="invalidateAllConfirmModalLabel">Confirm invalidation</h5>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to evict all objects from the <code>{{ cache.name }}</code> cache?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="invalidateAllConfirm">Invalidate</button>
                    </div>
                    <input type="hidden" id="cacheKey"/>
                </div>
            </div>
        </div>

        <div class="modal fade" id="invalidateConfirmModal" tabindex="-1" role="dialog" aria-labelledby="invalidateConfirmModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="invalidateConfirmModalLabel">Confirm invalidation</h5>
                    </div>
                    <div class="modal-body">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="invalidateConfirm">Invalidate</button>
                    </div>
                    <input type="hidden" id="cacheKey"/>
                </div>
            </div>
        </div>
    {{/not}}

    <script>
        $('#invalidateConfirmModal').on('show.bs.modal', function (event) {
            var modal = $(this)
            var button = $(event.relatedTarget) // Button that triggered the modal
            var key = button.data('key') // Extract info from data-* attributes
            var body = "Are you sure you want to evict object with key <code>" + key + "</code> from the <code>{{ cache.name }}</code> cache?"
            modal.find('.modal-body').html('<p class="card-text">' + body + '</p>')
            $('#cacheKey').val(key)
        })

        $('#invalidateConfirm').click(function(event) {
            var cacheKey = $('#cacheKey').val();
            $.ajax({
                url: '{{ ext.appPath }}/cache-control-panel-controller/{{ cache.name }}/' + cacheKey,
                type: 'DELETE',
                contentType: "application/json; charset=utf-8",
                success: function(result) {
                    $('#invalidateConfirmModal').modal('hide')
                    $('#cacheKey').val('')
                    globalAlertMessageReload("Success", "Object with key " + cacheKey + " successfully removed from the cache {{ cache.name}}", "alert-success", "fa-check")
                },
                error: function(xhr, status, error) {
                    $('#deleteConfirmModal').modal('hide')
                    globalAlertMessageDisplay('Error', error, 'alert-danger', 'fa-circle-exclamation')
                }
            });
        })

        $('#invalidateAllConfirm').click(function(event) {
            $.ajax({
                url: '{{ ext.appPath }}/cache-control-panel-controller/{{ cache.name }}',
                type: 'DELETE',
                contentType: "application/json; charset=utf-8",
                success: function(result) {
                    $('#invalidateAllConfirmModal').modal('hide')
                    globalAlertMessageReload("Success", "Cache {{ cache.name}} emptied successfully", "alert-success", "fa-check")
                },
                error: function(xhr, status, error) {
                    $('#deleteConfirmModal').modal('hide')
                    globalAlertMessageDisplay('Error', error, 'alert-danger', 'fa-circle-exclamation')
                }
            });
        })

    </script>
{{/with}}
