{{#with controlPanel.body }}
    {{#each factories as |factory|}}
        <p class="card-text">
            <code>{{factory.name}}</code>
            {{#if factory.product}}<span class="badge badge-secondary">{{factory.product}}</span>{{/if}}
            {{#if factory.pool}}<span class="text-muted">{{factory.pool.acquired}} / {{factory.pool.maxAllocated}} connections in use</span>{{/if}}
        </p>
    {{else}}
        <p class="card-text text-muted">No R2DBC connection factories.</p>
    {{/each}}
{{/with}}
