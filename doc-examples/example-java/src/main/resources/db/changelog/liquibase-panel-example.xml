<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-liquibase-panel-table" author="control-panel" context="dev" labels="core">
        <comment>Create a table so the Control Panel example can inspect applied history.</comment>
        <createTable tableName="liquibase_panel_sample">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-tag-liquibase-panel" author="control-panel">
        <tagDatabase tag="panel-example"/>
    </changeSet>
</databaseChangeLog>
