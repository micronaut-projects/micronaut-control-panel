{{#with controlPanel.body }}
    <div class="cp-dashboard-stack">
        <div class="card card-light">
            <div class="card-header">
                <h3 class="card-title">Storage configuration</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#uploadModal"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true" title="{{ ext.writeAccess.reason }}"{{/unless}}>
                        <i class="fa fa-upload"></i>
                        Upload file
                    </button>
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    {{#each metadata}}
                        <dt class="col-sm-2">{{ titleize (decamelize @key) }}</dt>
                        <dd class="col-sm-10"><code>{{this}}</code></dd>
                    {{/each}}
                </dl>
            </div>
        </div>

        <div class="card card-light">
            <div class="card-header">
                <h3 class="card-title">Files</h3>
            </div>
            <div class="card-body">
                {{#if entries }}
                    <div class="cp-data-table" data-filter-table data-filter-table-label="file" data-filter-table-label-plural="files">
                        <div class="cp-data-table-toolbar">
                            <div class="cp-data-table-summary" data-filter-table-summary>{{ entries.size }} files</div>
                            <div class="cp-data-table-search">
                                <input type="text" class="form-control" data-filter-table-search placeholder="Search files" aria-label="Search files">
                            </div>
                        </div>
                        <div class="cp-data-table-container">
                            <table class="table cp-data-table-table cp-data-table-fixed">
                                <thead>
                                <tr>
                                    <th>Name</th>
                                    <th class="cp-object-storage-content-type">Content Type</th>
                                    <th class="cp-object-storage-actions">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                {{#each entries as |entry|}}
                                    <tr data-filter-table-row>
                                        <td><code class="cp-table-code">{{entry.key}}</code></td>
                                        <td class="cp-object-storage-content-type">
                                            {{ unwrapOptional entry.contentType }}
                                        </td>
                                        <td class="cp-object-storage-actions">
                                            <details class="cp-actions-menu cp-actions-menu-end" data-actions-menu>
                                                <summary class="btn btn-ghost btn-icon" aria-label="Open actions menu for {{entry.key}}" title="Actions">
                                                    <i class="fas fa-ellipsis"></i>
                                                </summary>
                                                <div class="cp-actions-menu-content">
                                                    <button type="button" class="cp-actions-menu-item" data-download-key="{{entry.key}}">
                                                        <i class="fa fa-download"></i>
                                                        Download
                                                    </button>
                                                    <button type="button" class="cp-actions-menu-item cp-actions-menu-item-danger" data-toggle="modal" data-target="#deleteConfirmModal" data-key="{{entry.key}}"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true" title="{{ ext.writeAccess.reason }}"{{/unless}}>
                                                        <i class="fa fa-trash"></i>
                                                        Delete
                                                    </button>
                                                </div>
                                            </details>
                                        </td>
                                    </tr>
                                {{/each}}
                                <tr data-filter-table-empty hidden>
                                    <td class="cp-data-table-empty-cell" colspan="3">No files found.</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                {{else}}
                    <div class="cp-data-table-empty">No files stored.</div>
                {{/if}}
            </div>
        </div>
    </div>

    {{#if entries }}
        <div class="modal fade cp-dialog" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-labelledby="deleteConfirmModalLabel" aria-describedby="deleteConfirmModalDescription" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content cp-dialog-content">
                    <div class="modal-header cp-dialog-header">
                        <div class="cp-dialog-heading">
                            <h5 class="modal-title cp-dialog-title" id="deleteConfirmModalLabel">
                                <i class="fa fa-trash"></i>
                                Confirm deletion
                            </h5>
                            <p class="cp-dialog-description" id="deleteConfirmModalDescription">This permanently removes the selected file.</p>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" title="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M18 6 6 18"></path>
                                <path d="m6 6 12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="modal-body">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="deleteConfirm"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true" title="{{ ext.writeAccess.reason }}"{{/unless}}>Delete</button>
                    </div>
                </div>
            </div>
        </div>
    {{/if}}

    <div class="modal fade cp-dialog" id="uploadModal" tabindex="-1" role="dialog" aria-labelledby="uploadModalLabel" aria-describedby="uploadModalDescription" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content cp-dialog-content">
                <div class="modal-header cp-dialog-header">
                    <div class="cp-dialog-heading">
                        <h5 class="modal-title cp-dialog-title" id="uploadModalLabel">
                            <i class="fa fa-upload"></i>
                            Upload file
                        </h5>
                        <p class="cp-dialog-description" id="uploadModalDescription">Add a file to this object storage provider.</p>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" title="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 6 6 18"></path>
                            <path d="m6 6 12 12"></path>
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <form id="uploadForm" enctype="multipart/form-data" action="{{ ext.controlPanelPath }}/object-storage-control-panel-controller/{{ controlPanel.title }}">
                            <label for="fileUpload" class="col-form-label">File:</label>
                            <input id="fileUpload" type="file" name="fileUpload">
                        </form>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="upload"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true" title="{{ ext.writeAccess.reason }}"{{/unless}}>Upload</button>
                </div>
            </div>
        </div>
    </div>

    <script>

        $('#upload').click(function(e){
            if (!{{ ext.writeAccess.allowed }} || this.disabled) {
                return;
            }
            var form = $('#uploadForm')[0]
            var formData = new FormData(form)

            $.ajax({
                url: form.action,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    $('#uploadModal').modal('hide')
                    globalAlertMessageReload('Success', 'File uploaded successfully', 'alert-success', 'fa-check')
                },
                error: function(xhr, status, error) {
                    $('#uploadModal').modal('hide')
                    globalAlertMessageDisplay('Error', error, 'alert-danger', 'fa-circle-exclamation')
                }
            });
        })

        $('#deleteConfirmModal').on('show.bs.modal', function (event) {
            var modal = $(this)
            var button = $(event.relatedTarget)
            var key = button.attr('data-key')
            var body = "Are you sure you want to delete the file <code>" + key + "</code>?"
            modal.find('.modal-body').html('<p class="card-text">' + body + '</p>')
            $('#deleteConfirm').attr('data-key', key)
        })

        $('#deleteConfirm').click(function(event) {
            if (!{{ ext.writeAccess.allowed }} || this.disabled) {
                return;
            }
            var fileKey = $(this).attr('data-key');
            $.ajax({
                url: '{{ ext.controlPanelPath }}/object-storage-control-panel-controller/{{ controlPanel.title }}/' + fileKey,
                type: 'DELETE',
                contentType: "application/json; charset=utf-8",
                success: function(result) {
                    $('#deleteConfirmModal').modal('hide')
                    $('#deleteConfirm').removeAttr('data-key')
                    globalAlertMessageReload("Success", "File " + fileKey + " deleted successfully", "alert-success", "fa-check")
                },
                error: function(xhr, status, error) {
                    $('#deleteConfirmModal').modal('hide')
                    globalAlertMessageDisplay('Error', error, 'alert-danger', 'fa-circle-exclamation')
                }
            });
        })

        $(document).on('click', '[data-download-key]', function () {
            var menu = this.closest('[data-actions-menu]')
            if (menu) {
                menu.removeAttribute('open')
            }
            download('{{ controlPanel.title }}', $(this).attr('data-download-key'));
        })

        function download(objectStorageName, fileKey) {
            $.ajax({
                url: '{{ ext.controlPanelPath }}/object-storage-control-panel-controller/' + objectStorageName + '/' + fileKey,
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                xhrFields: {
                    responseType: 'blob'
                },
                success: function(data) {
                    var url = window.URL.createObjectURL(data);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = fileKey;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                },
                error: function(xhr, status, error) {
                    globalAlertMessageDisplay('Error', error, 'alert-danger', 'fa-circle-exclamation')
                }
            });
        }
    </script>
{{/with}}
