{{#with controlPanel.body }}
    <p class="card-text">
    <dl class="row">
        {{#each metadata}}
            <dt class="col-sm-2">{{ titleize (decamelize (cut @key '()')) }}</dt>
            <dd class="col-sm-10"><code>{{this}}</code></dd>
        {{/each}}
    </dl>

    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#actionsModal">
        <i class="fa fa-upload"></i>
        Upload file
    </button>

    </p>

    {{#if entries }}
        <p class="card-text">
        <table class="table">
            <thead>
            <tr>
                <th>Name</th>
                <th>Content Type</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {{#each entries as |entry|}}
                <tr>
                    <td><code>{{entry.key}}</code></td>
                    <td>
                        {{ unwrapOptional entry.contentType }}
                    </td>
                    <td>
                        <button type="button" class="btn btn-primary btn-sm" data-toggle="modal"
                                data-target="#actionsModal" data-logger="{{@key}}"
                                data-currentlevel="{{ logger.configuredLevel }}">
                            <i class="fa fa-download"></i>
                            Download
                        </button>
                        <button type="button" class="btn btn-danger btn-sm" data-toggle="modal"
                                data-target="#actionsModal" data-logger="{{@key}}"
                                data-currentlevel="{{ logger.configuredLevel }}">
                            <i class="fa fa-trash"></i>
                            Delete
                        </button>
                    </td>
                </tr>
            {{/each}}
            </tbody>
        </table>
        </p>
    {{/if}}

{{/with}}
