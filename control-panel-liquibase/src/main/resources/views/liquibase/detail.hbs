{{#with controlPanel.body as |body|}}
    {{#if body.hasConfigurations}}
        <div class="table-responsive">
            <table class="table table-sm table-bordered">
                <thead>
                <tr>
                    <th scope="col">Datasource</th>
                    <th scope="col">State</th>
                    <th scope="col">Applied change sets</th>
                    <th scope="col">Latest execution</th>
                    {{#if body.showDeploymentIds}}<th scope="col">Latest deployment ID</th>{{/if}}
                    <th scope="col">Latest tag</th>
                </tr>
                </thead>
                <tbody>
                {{#each body.dataSources as |history|}}
                    <tr>
                        <td><code>{{history.name}}</code></td>
                        <td><span class="badge badge-{{history.badgeClass}}">{{history.stateLabel}}</span></td>
                        <td>{{history.count}}</td>
                        <td>{{#if history.latestExecutionDate}}<code>{{history.latestExecutionDate}}</code>{{else}}<span class="text-muted">None</span>{{/if}}</td>
                        {{#if body.showDeploymentIds}}
                            <td>{{#if history.latestDeploymentId}}<code>{{history.latestDeploymentId}}</code>{{else}}<span class="text-muted">None</span>{{/if}}</td>
                        {{/if}}
                        <td>{{#if history.latestTag}}<code>{{history.latestTag}}</code>{{else}}<span class="text-muted">None</span>{{/if}}</td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
        {{#each body.dataSources as |history|}}
            {{#if history.errorMessage}}
                <div class="alert alert-danger">
                    Liquibase history for <code>{{history.name}}</code> could not be read: {{history.errorMessage}}
                </div>
            {{/if}}
            {{#if history.isDisabled}}
                <div class="alert alert-secondary">
                    Liquibase configuration <code>{{history.name}}</code> is disabled.
                </div>
            {{/if}}
            {{#if history.isEmptyHistory}}
                <div class="alert alert-info">
                    Liquibase configuration <code>{{history.name}}</code> is enabled, but no applied change sets were found.
                </div>
            {{/if}}
        {{/each}}

        {{#each body.dataSources as |history|}}
            {{#if history.hasChangeSets}}
                <h4><code>{{history.name}}</code> change sets</h4>
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                        <tr>
                            <th scope="col">Order</th>
                            <th scope="col">ID</th>
                            <th scope="col">Author</th>
                            <th scope="col">Changelog</th>
                            <th scope="col">Stored changelog</th>
                            <th scope="col">Description</th>
                            <th scope="col">Exec type</th>
                            <th scope="col">Execution date</th>
                            {{#if body.showDeploymentIds}}<th scope="col">Deployment ID</th>{{/if}}
                            <th scope="col">Contexts</th>
                            <th scope="col">Labels</th>
                            <th scope="col">Tag</th>
                            {{#if body.showChecksums}}<th scope="col">Checksum</th>{{/if}}
                        </tr>
                        </thead>
                        <tbody>
                        {{#each history.changeSets as |changeSet|}}
                            <tr>
                                <td>{{changeSet.orderExecuted}}</td>
                                <td><code>{{changeSet.id}}</code></td>
                                <td><code>{{changeSet.author}}</code></td>
                                <td><code>{{changeSet.changeLog}}</code></td>
                                <td>{{#if changeSet.storedChangeLog}}<code>{{changeSet.storedChangeLog}}</code>{{else}}<span class="text-muted">None</span>{{/if}}</td>
                                <td>{{#if changeSet.description}}{{changeSet.description}}{{else}}<span class="text-muted">None</span>{{/if}}</td>
                                <td><code>{{changeSet.execType}}</code></td>
                                <td><code>{{changeSet.dateExecuted}}</code></td>
                                {{#if body.showDeploymentIds}}
                                    <td>{{#if changeSet.deploymentId}}<code>{{changeSet.deploymentId}}</code>{{else}}<span class="text-muted">None</span>{{/if}}</td>
                                {{/if}}
                                <td>
                                    {{#if changeSet.contexts}}
                                        {{#each changeSet.contexts as |context|}}<code>{{context}}</code> {{/each}}
                                    {{else}}
                                        <span class="text-muted">None</span>
                                    {{/if}}
                                </td>
                                <td>
                                    {{#if changeSet.labels}}
                                        {{#each changeSet.labels as |label|}}<code>{{label}}</code> {{/each}}
                                    {{else}}
                                        <span class="text-muted">None</span>
                                    {{/if}}
                                </td>
                                <td>{{#if changeSet.tag}}<code>{{changeSet.tag}}</code>{{else}}<span class="text-muted">None</span>{{/if}}</td>
                                {{#if body.showChecksums}}
                                    <td>{{#if changeSet.checksum}}<code>{{changeSet.checksum}}</code>{{else}}<span class="text-muted">None</span>{{/if}}</td>
                                {{/if}}
                            </tr>
                        {{/each}}
                        </tbody>
                    </table>
                </div>
            {{/if}}
        {{/each}}

        {{#unless body.showDeploymentIds}}
            <div class="alert alert-secondary">Deployment IDs are hidden by Control Panel configuration.</div>
        {{/unless}}
        {{#unless body.showChecksums}}
            <div class="alert alert-secondary">Checksums are hidden by Control Panel configuration.</div>
        {{/unless}}
    {{else}}
        <div class="alert alert-info">
            No Liquibase datasource configuration was detected. Add <code>micronaut-liquibase</code> and configure
            <code>liquibase.datasources.*</code> to inspect applied change-set history.
        </div>
    {{/if}}
{{/with}}
