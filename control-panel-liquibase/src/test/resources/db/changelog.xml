<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="create-book" author="alvaro" labels="catalog">
        <comment>Books table</comment>
        <createTable tableName="book">
            <column name="id" type="bigint"><constraints primaryKey="true"/></column>
            <column name="title" type="varchar(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="tag-1.0" author="alvaro">
        <tagDatabase tag="1.0"/>
    </changeSet>
    <changeSet id="add-isbn" author="alvaro" context="dev">
        <addColumn tableName="book">
            <column name="isbn" type="varchar(20)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
