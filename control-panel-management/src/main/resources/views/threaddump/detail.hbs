{{#with controlPanel.threadDump }}
    <div class="cp-dashboard-stack">
        <div class="card card-light">
            <div class="card-header">
                <h3 class="card-title">Thread Dump</h3>
                <div class="card-tools">
                    <a class="btn btn-primary btn-sm" href="{{../ext.controlPanelPath}}/threaddump">
                        <i class="fa fa-rotate-right" aria-hidden="true"></i>
                        Refresh dump
                    </a>
                </div>
            </div>
            <div class="card-body">
                <p class="card-text">Current JVM thread snapshot from Micronaut Management.</p>
                <p class="card-text text-muted">Thread names and stack traces can reveal implementation details. Use this panel in trusted development or test environments.</p>
                {{#if stateCounts}}
                    <dl class="row">
                        <dt class="col-sm-2">Threads</dt>
                        <dd class="col-sm-10"><strong>{{totalThreads}}</strong></dd>
                        <dt class="col-sm-2">States</dt>
                        <dd class="col-sm-10">
                            {{#each stateCounts}}
                                <span class="badge {{badgeClass}}">{{state}}: {{count}}</span>
                            {{/each}}
                        </dd>
                    </dl>
                {{else}}
                    {{#if unsupportedMapper}}
                        <p class="card-text"><strong>{{totalThreads}}</strong> entries were returned by the configured ThreadInfoMapper.</p>
                    {{else}}
                        <p class="card-text">No threads were returned by the Thread Dump endpoint.</p>
                    {{/if}}
                {{/if}}
            </div>
        </div>

        <div class="card card-light">
            <div class="card-header">
                <h3 class="card-title">Threads</h3>
            </div>
            <div class="card-body">
                {{#if threads}}
                    <div class="cp-data-table cp-data-table-unpaged" data-filter-table data-filter-table-unpaged data-filter-table-label="thread" data-filter-table-label-plural="threads">
                        <div class="cp-data-table-toolbar">
                            <div class="cp-data-table-summary" data-filter-table-summary>{{totalThreads}} threads</div>
                            <div class="cp-data-table-search">
                                <input type="search" class="form-control" data-filter-table-search placeholder="Search threads, states, locks, or stack frames" aria-label="Search thread dump">
                            </div>
                        </div>
                        <div class="cp-data-table-container cp-thread-table-container">
                            <table class="table cp-data-table-table cp-data-table-fixed cp-thread-table">
                                <colgroup>
                                    <col class="cp-thread-state-column">
                                    <col class="cp-thread-name-column">
                                    <col class="cp-thread-id-column">
                                    <col class="cp-thread-daemon-column">
                                    <col class="cp-thread-lock-column">
                                    <col class="cp-thread-count-column">
                                    <col class="cp-thread-count-column">
                                    <col class="cp-thread-stack-column">
                                </colgroup>
                                <thead>
                                <tr>
                                    <th>State</th>
                                    <th>Thread</th>
                                    <th>ID</th>
                                    <th>Daemon</th>
                                    <th>Lock / owner</th>
                                    <th>Blocked</th>
                                    <th>Waited</th>
                                    <th>Stack</th>
                                </tr>
                                </thead>
                                <tbody>
                                {{#each threads as |thread|}}
                                    <tr data-filter-table-row>
                                        <td data-label="State">
                                            <span class="badge {{thread.badgeClass}}">{{thread.state}}</span>
                                            {{#if thread.blocked}}
                                                <span class="badge badge-danger">Blocked</span>
                                            {{/if}}
                                        </td>
                                        <td data-label="Thread"><code class="cp-table-code">{{thread.threadName}}</code></td>
                                        <td data-label="ID">{{thread.threadId}}</td>
                                        <td data-label="Daemon">{{thread.daemon}}</td>
                                        <td data-label="Lock / owner">
                                            {{#if thread.lockName}}
                                                <code class="cp-table-code">{{thread.lockName}}</code>
                                            {{else}}
                                                <span class="text-muted">—</span>
                                            {{/if}}
                                            {{#if thread.hasLockOwner}}
                                                <br>
                                                <span class="text-muted">owner:</span>
                                                {{#if thread.lockOwnerName}}
                                                    <code class="cp-table-code">{{thread.lockOwnerName}}</code>
                                                {{else}}
                                                    <span class="text-muted">unknown</span>
                                                {{/if}}
                                                <span class="text-muted">(#{{thread.lockOwnerId}})</span>
                                            {{/if}}
                                        </td>
                                        <td data-label="Blocked">
                                            {{thread.blockedCount}} /
                                            {{#if thread.hasBlockedTime}}
                                                {{thread.blockedTime}} ms
                                            {{else}}
                                                —
                                            {{/if}}
                                        </td>
                                        <td data-label="Waited">
                                            {{thread.waitedCount}} /
                                            {{#if thread.hasWaitedTime}}
                                                {{thread.waitedTime}} ms
                                            {{else}}
                                                —
                                            {{/if}}
                                        </td>
                                        <td data-label="Stack">
                                            {{#if thread.stackTrace}}
                                                <details>
                                                    <summary>Show stack trace</summary>
                                                    <pre class="cp-thread-stack"><code class="nohighlight">{{#each thread.stackTrace as |frame|}}{{frame}}
{{/each}}</code></pre>
                                                </details>
                                            {{else}}
                                                <span class="text-muted">No stack frames</span>
                                            {{/if}}
                                        </td>
                                    </tr>
                                {{/each}}
                                <tr data-filter-table-empty hidden>
                                    <td class="cp-data-table-empty-cell" colspan="8">No threads match your search.</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                {{else}}
                    <div class="cp-data-table-empty">
                        {{#if unsupportedMapper}}
                            This application configures a custom ThreadInfoMapper that does not produce
                            java.lang.management.ThreadInfo objects. The Thread Dump panel only renders what that mapper
                            returns, so it cannot display thread details here. Read the mapped output from the Micronaut
                            Management /threaddump endpoint instead.
                        {{else}}
                            Thread dump data is not available. On the JVM, confirm the Micronaut Management Thread Dump
                            endpoint is enabled for this environment. In a GraalVM native image this panel is always empty:
                            native images do not report thread dump data through the JVM management API.
                        {{/if}}
                    </div>
                {{/if}}
            </div>
        </div>
    </div>
{{/with}}
