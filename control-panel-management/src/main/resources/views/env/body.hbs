{{#with controlPanel.body }}
    <p class="card-text">
        Properties resolved across {{ propertySources.size }} property sources.
    </p>
    <p class="card-text">
        Active environments:
        {{#if activeEnvironments}}
            {{#each activeEnvironments }}
                <span class="badge cp-environment-tag">{{ this }}</span>
            {{/each}}
        {{else}}
            (none)
        {{/if}}
    </p>
{{/with}}
