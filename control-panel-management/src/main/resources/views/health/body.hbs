{{#with controlPanel.body }}

    {{#eq status.name 'UP'}}
        <div class="small-box bg-success">
            <div class="inner">
                <h3>Operational</h3>
                <p>All healthchecks passed</p>
            </div>
            <div class="icon">
                <i class="fas fa-check"></i>
            </div>
        </div>
    {{/eq}}
    {{#eq status.name 'DOWN'}}
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>Down</h3>
                <p>One or more healthchecks failed</p>
            </div>
            <div class="icon">
                <i class="fas fa-circle-exclamation"></i>
            </div>
        </div>
    {{/eq}}

{{/with}}
