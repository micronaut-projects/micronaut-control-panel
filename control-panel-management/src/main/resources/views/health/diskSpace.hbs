{{#with subDetails.details}}
    {{#eq subDetails.status.name 'UP'}}
        <p class="card-text">
            <div class="progress">
                <div class="progress-bar bg-warning" role="progressbar" style="width: {{minus 100 (percentage free total) }}%" aria-valuenow="{{minus 100 (percentage free total) }}" aria-valuemin="0" aria-valuemax="100">used</div>
                <div class="progress-bar bg-success" role="progressbar" style="width: {{percentage free total }}%" aria-valuenow="{{percentage free total }}" aria-valuemin="0" aria-valuemax="100">free</div>
            </div>
        </p>
        <p class="card-text">
            <table class="table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Total</td>
                        <td>{{#if total}}{{binaryPrefix total }}{{else}}N/A{{/if}}</td>
                    </tr>
                    <tr>
                        <td>Free</td>
                        <td>{{#if free}}{{binaryPrefix free }}{{else}}N/A{{/if}}</td>
                    </tr>
                    <tr>
                        <td>Threshold</td>
                        <td>{{#if threshold}}{{binaryPrefix threshold }}{{else}}N/A{{/if}}</td>
                    </tr>
                </tbody>
            </table>
        </p>
    {{/eq}}
    {{#eq subDetails.status.name 'DOWN'}}
        <p class="card-text">
            <blockquote class="quote-danger">
                <h5 id="reminder-1">Down</h5>
                <p>{{subDetails.details.error}}</p>
            </blockquote>
        </p>
    {{/eq}}
{{/with}}
