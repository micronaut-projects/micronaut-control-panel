{{#with controlPanel.body }}

    {{#eq status.name 'UP'}}
        <div class="alert alert-success">
            <h5><i class="icon fas fa-check"></i> All health checks passed</h5>
        </div>
    {{/eq}}

    <div class="card-columns">
        {{#each details as |subDetails|}}
            {{#if subDetails.details}}
                {{#partialExists (stringFormat "views/health/%s" (cut @key '()'))}}
                    {{#eq subDetails.status.name 'UP'}}
                        <div class="card card-success">
                    {{/eq}}
                    {{#eq subDetails.status.name 'DOWN'}}
                        <div class="card card-danger">
                    {{/eq}}
                    {{#eq subDetails.status.name 'UNKNOWN'}}
                        <div class="card card-warning">
                    {{/eq}}

                        <div class="card-header">
                            <h3 class="card-title">{{titleize (decamelize (cut @key '()')) }}</h3>
                        </div>
                        <div class="card-body">
                            {{> (stringFormat "views/health/%s" (cut @key '()')) parameter=subDetails }}
                        </div>
                    </div>
                {{else}}
                    {{#eq subDetails.status.name 'UP'}}
                        <div class="card card-success">
                    {{/eq}}
                    {{#eq subDetails.status.name 'DOWN'}}
                        <div class="card card-danger">
                    {{/eq}}
                    {{#eq subDetails.status.name 'UNKNOWN'}}
                        <div class="card card-warning">
                    {{/eq}}

                        <div class="card-header">
                            <h3 class="card-title">{{titleize (decamelize (cut @key '()')) }}</h3>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                {{#isMap subDetails.details}}
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Property</th>
                                                <th>Value</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{#each subDetails.details as |it|}}
                                                <tr>
                                                    <td>{{titleize (decamelize (cut @key '()')) }}</td>
                                                    <td>{{it}}</td>
                                                </tr>
                                            {{/each}}
                                        </tbody>
                                    </table>
                                {{else}}
                                    {{subDetails.details}}
                                {{/isMap}}
                            </p>
                        </div>
                    </div>
                {{/partialExists}}
            {{/if}}
        {{/each}}
    </div>

{{/with}}
