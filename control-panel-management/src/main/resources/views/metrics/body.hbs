{{#with controlPanel.body }}
    {{#if names}}
        <p class="card-text">
            <strong>{{../controlPanel.badge}}</strong> metrics available.
        </p>
        <p class="card-text">
            {{#each names}}
                {{#lt @index 8}}
                    <code>{{this}}</code>{{#unless @last}}{{#lt @index 7}}, {{/lt}}{{/unless}}
                {{/lt}}
            {{/each}}
            {{#gt (size names) 8}}
                and {{minus (size names) 8}} more.
            {{/gt}}
        </p>
    {{else}}
        <p class="card-text">No Micrometer metrics are available.</p>
    {{/if}}
{{/with}}
