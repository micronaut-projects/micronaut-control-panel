{{#with controlPanel.body }}
<div class="cp-dashboard-stack">
    <div class="card card-light">
        <div class="card-header">
            <h3 class="card-title">Logger configuration</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#actionsModal">
                    <i class="fa fa-plus"></i>
                    Add new logger
                </button>
            </div>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">Levels</dt>
                <dd class="col-sm-10">
                    {{#each levels}}
                        <span class="badge">{{ this }}</span>
                    {{/each}}
                </dd>

                {{#if loggers.ROOT }}
                    <dt class="col-sm-2">Effective level for unconfigured packages</dt>
                    <dd class="col-sm-10">
                        <span class="badge">{{ loggers.ROOT.configuredLevel }}</span>
                    </dd>
                {{/if}}
            </dl>
        </div>
    </div>

    <div class="card card-light">
        <div class="card-header">
            <h3 class="card-title">Configured loggers</h3>
        </div>
        <div class="card-body">
            <div class="cp-data-table" data-filter-table data-filter-table-label="logger" data-filter-table-label-plural="loggers">
                <div class="cp-data-table-toolbar">
                    <div class="cp-data-table-summary" data-filter-table-summary>{{ loggers.size }} loggers</div>
                    <div class="cp-data-table-search">
                        <input type="text" class="form-control" data-filter-table-search placeholder="Search loggers" aria-label="Search loggers">
                    </div>
                </div>
                <div class="cp-data-table-container">
                    <table class="table cp-data-table-table cp-data-table-fixed">
                        <thead>
                        <tr>
                            <th>Logger name</th>
                            <th class="cp-logger-level">Level</th>
                            <th class="cp-logger-actions">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#each loggers as |logger|}}
                            <tr data-filter-table-row>
                                <td><code class="cp-table-code">{{@key}}</code></td>
                                <td class="cp-logger-level">
                                    <span class="badge">{{ logger.configuredLevel }}</span>
                                </td>
                                <td class="cp-logger-actions">
                                    <button type="button" class="btn btn-secondary btn-sm" data-toggle="modal" data-target="#actionsModal" data-logger="{{@key}}" data-currentlevel="{{ logger.configuredLevel }}">
                                        <i class="fa fa-edit"></i>
                                        Reconfigure
                                    </button>
                                </td>
                            </tr>
                        {{/each}}
                        <tr data-filter-table-empty hidden>
                            <td class="cp-data-table-empty-cell" colspan="3">No loggers found.</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade cp-dialog" id="actionsModal" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content cp-dialog-content">
            <div class="modal-header cp-dialog-header">
                <div class="cp-dialog-heading">
                    <h5 class="modal-title cp-dialog-title" id="modalLabel">Reconfigure logger</h5>
                    <p class="cp-dialog-description">Set an explicit log level for a logger name.</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" title="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <form id="configureLogger">
                    <div class="form-group">
                        <label for="logger" class="col-form-label">Logger name:</label>
                        <input type="text" class="form-control" id="logger" name="logger" aria-describedby="loggerHelp loggerError">
                        <small id="loggerHelp" class="form-text text-muted">Logger writes use the protected Control Panel route. The raw Management loggers endpoint can remain write-sensitive.</small>
                        <div class="invalid-feedback" id="loggerError">Logger name must not be blank.</div>
                        <label for="configuredLevel" class="col-form-label">Level:</label>
                        <select name="configuredLevel" class="form-control" id="configuredLevel">
                            {{#each levels as |level|}}
                                <option>{{level}}</option>
                            {{/each}}
                        </select>
                    </div>
                </form>
                <div id="result"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="submit">Submit</button>
            </div>
        </div>
    </div>
</div>

<script>
    var loggerModalTrigger = null;
    var configuredLoggerButton = null;

    $('#actionsModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        loggerModalTrigger = button[0];
        configuredLoggerButton = null;
        var logger = button.data('logger');
        var currentlevel = button.data('currentlevel');

        var modal = $(this);
        $('#result').empty();
        clearLoggerValidation();
        if (logger) {
            modal.find('.modal-title').empty().append(document.createTextNode('Reconfigure logger ')).append($('<code>').text(logger));
            modal.find('.modal-body input').val(logger);
            modal.find('.modal-body select').val(currentlevel);
        } else {
            modal.find('.modal-title').text('Configure new logger');
            modal.find('.modal-body input').val('');
            modal.find('.modal-body select').val('');
        }
        $('#submit').show().prop('disabled', false).removeAttr('aria-describedby').removeAttr('title');
    })

    $('#actionsModal').on('hidden.bs.modal', function (e) {
        $('#result').empty();
        clearLoggerValidation();
        if (configuredLoggerButton) {
            configuredLoggerButton.focus();
        } else if (loggerModalTrigger) {
            loggerModalTrigger.focus();
        }
    })

    $('#submit').click(function(e){
        submitForm();
    })

    $('#logger').on('input', function () {
        clearLoggerValidation();
    })

    function submitForm(){
        var loggerInput = $('#logger');
        var logger = loggerInput.val().trim();
        if (!logger) {
            loggerInput.addClass('is-invalid').attr('aria-invalid', 'true').focus();
            setResult('danger', 'Enter a logger name before submitting.');
            return;
        }
        var payload = {
            configuredLevel: $("#configuredLevel").val()
        }
        $.ajax({
            type: "POST",
            url: "{{ ext.controlPanelPath }}/loggers-control-panel-controller/" + encodeURIComponent(logger),
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
        }).done(function (data) {
            updateConfiguredLogger(logger, payload.configuredLevel);
            setResult('success', 'Logger configured through the Control Panel route.');
            $('#submit').hide();
        }).fail(function (data) {
            var message = data.responseJSON && data.responseJSON.message ? data.responseJSON.message : 'Logger could not be configured.';
            if (data.status === 401 || data.status === 403) {
                message = 'You do not have permission to reconfigure loggers through the Control Panel.';
                $('#submit')
                    .prop('disabled', true)
                    .attr('aria-describedby', 'result')
                    .attr('title', message);
            }
            setResult('danger', message);
        });
    }

    function clearLoggerValidation() {
        $('#logger').removeClass('is-invalid').removeAttr('aria-invalid');
    }

    function setResult(type, message) {
        $('#result').empty().append($('<div>', {
            class: 'alert alert-' + type,
            role: 'alert',
            text: message
        }));
    }

    function updateConfiguredLogger(logger, configuredLevel) {
        var button = findLoggerButton(logger);
        if (button.length === 0) {
            var row = $('<tr>', {'data-filter-table-row': ''});
            row.append($('<td>').append($('<code>', {class: 'cp-table-code', text: logger})));
            row.append($('<td>', {class: 'cp-logger-level'}).append($('<span>', {class: 'badge', text: configuredLevel})));
            row.append($('<td>', {class: 'cp-logger-actions'}).append($('<button>', {
                type: 'button',
                class: 'btn btn-secondary btn-sm',
                'data-toggle': 'modal',
                'data-target': '#actionsModal',
                'data-logger': logger,
                'data-currentlevel': configuredLevel
            }).append($('<i>', {class: 'fa fa-edit'})).append(document.createTextNode(' Reconfigure'))));
            $('tr[data-filter-table-empty]').before(row);
            button = row.find('button');
        } else {
            button.data('currentlevel', configuredLevel).attr('data-currentlevel', configuredLevel);
            button.closest('tr').find('.cp-logger-level .badge').text(configuredLevel);
        }
        configuredLoggerButton = button[0];
    }

    function findLoggerButton(logger) {
        return $('[data-logger]').filter(function () {
            return $(this).data('logger') === logger;
        }).first();
    }
</script>

{{/with}}
