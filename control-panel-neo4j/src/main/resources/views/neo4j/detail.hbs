{{#with controlPanel.detailedBody }}
<div class="cp-dashboard-stack">
    <div class="card card-light">
        <div class="card-header">
            <h3 class="card-title">Server</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">URI</dt>
                <dd class="col-sm-9"><code>{{uri}}</code></dd>
                <dt class="col-sm-3">Authentication</dt>
                <dd class="col-sm-9">{{authentication}}</dd>
                {{#if server}}
                    <dt class="col-sm-3">Version</dt>
                    <dd class="col-sm-9">{{server.name}} {{server.version}} <span class="badge badge-secondary">{{server.edition}}</span></dd>
                {{/if}}
            </dl>
            {{#if error}}
                <div class="alert alert-warning mb-0">Unable to read the server: {{error}}. See the application log at DEBUG level for details.</div>
            {{/if}}
        </div>
    </div>

    {{#if databases}}
    <div class="card card-light">
        <div class="card-header">
            <h3 class="card-title">Databases</h3>
        </div>
        <div class="card-body">
            <div class="cp-data-table-container">
                <table class="table cp-data-table-table">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each databases as |database|}}
                        <tr>
                            <td><code class="cp-table-code">{{database.name}}</code>{{#if database.isDefault}} <span class="badge badge-secondary">default</span>{{/if}}</td>
                            <td><span class="badge {{database.badgeClass}}">{{database.status}}</span></td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/if}}

    {{#if graph}}
    <div class="card card-light">
        <div class="card-header">
            <h3 class="card-title">Default database</h3>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Nodes</dt>
                <dd class="col-sm-9">{{graph.nodes}}</dd>
                <dt class="col-sm-3">Relationships</dt>
                <dd class="col-sm-9">{{graph.relationships}}</dd>
                <dt class="col-sm-3">Labels</dt>
                <dd class="col-sm-9">{{#each graph.labels as |label|}}<code>{{label}}</code> {{else}}<span class="text-muted">none</span>{{/each}}</dd>
                <dt class="col-sm-3">Relationship types</dt>
                <dd class="col-sm-9">{{#each graph.relationshipTypes as |type|}}<code>{{type}}</code> {{else}}<span class="text-muted">none</span>{{/each}}</dd>
            </dl>
        </div>
    </div>
    {{/if}}
</div>
{{/with}}
