{{#with controlPanel.body as |body|}}
<p class="card-text">
    <strong>{{ body.summary.totalClients }}</strong> Pulsar clients registered in this application.
</p>
<dl class="row mb-0">
    <dt class="col-sm-5">Producers</dt>
    <dd class="col-sm-7"><span class="badge badge-primary">{{ body.summary.producers }}</span></dd>
    <dt class="col-sm-5">Consumers</dt>
    <dd class="col-sm-7">
        <span class="badge badge-primary">{{ body.summary.consumers }}</span>
        {{#if body.summary.pausedConsumers}}
            <span class="badge badge-warning">{{ body.summary.pausedConsumers }} paused</span>
        {{/if}}
    </dd>
    <dt class="col-sm-5">Readers</dt>
    <dd class="col-sm-7"><span class="badge badge-primary">{{ body.summary.readers }}</span></dd>
    <dt class="col-sm-5">Failures</dt>
    <dd class="col-sm-7"><span class="badge badge-danger">{{ body.summary.failures }}</span></dd>
</dl>
{{#unless body.consumerRegistryPresent}}
    <p class="card-text text-muted mt-3">No Pulsar consumer registry bean is available.</p>
{{/unless}}
{{#unless body.producerRegistryPresent}}
    <p class="card-text text-muted mt-3">No Pulsar producer registry bean is available.</p>
{{/unless}}
{{#unless body.readerRegistryPresent}}
    <p class="card-text text-muted mt-3">No Pulsar reader registry bean is available.</p>
{{/unless}}
{{/with}}
