<div class="cp-panel-grid">
    {{#each ext.controlPanels as |controlPanel|}}
        <article class="card cp-card cp-panel-card">
            <div class="card-header">
                <div class="cp-card-heading">
                    {{#if controlPanel.icon}}
                        <span class="cp-card-icon">
                            <i class="fa {{ controlPanel.icon }}"></i>
                        </span>
                    {{/if}}
                    <h2 class="cn-card-title cn-font-heading">
                        {{{ controlPanel.title }}}
                    </h2>
                </div>
                <div class="cp-card-action">
                    {{#if controlPanel.badge }}
                        <span class="badge badge-secondary">{{ controlPanel.badge }}</span>
                    {{/if}}
                </div>
            </div>
            <div class="card-body cp-card-content">
                {{> (lookup . 'controlPanel.bodyView.file') parameter=controlPanel }}
            </div>
            {{#eq controlPanel.name "test-resources"}}
                <div class="cp-card-footer">
                    <a class="btn btn-secondary btn-sm w-100" target="_blank" rel="nofollow noreferrer" href="{{controlPanel.body}}/control-panel">
                        Test Resources Control Panel
                        <i class="fas fa-arrow-up-right-from-square"></i>
                    </a>
                </div>
            {{else}}
                {{#if controlPanel.hasDetails}}
                <div class="cp-card-footer">
                    <a class="btn btn-secondary btn-sm w-100" role="button" href="{{ext.controlPanelPath}}/{{ controlPanel.name }}">
                        {{ controlPanel.detailLinkName }}
                    </a>
                </div>
                {{/if}}
            {{/eq}}
        </article>
    {{/each}}
</div>
