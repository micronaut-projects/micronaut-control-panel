<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        Micronaut Control Panel
        {{#if ext.controlPanel.title}}
            - {{{ ext.controlPanel.title }}}
        {{/if}}
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="//fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.2.0/css/all.min.css">
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/simple-icons-font@v16/font/simple-icons.min.css" type="text/css">
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="//cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.7.0/build/styles/github.min.css">
    <script>
        (function () {
            function preferredTheme() {
                if (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches) {
                    return "light";
                }
                return "dark";
            }

            try {
                var theme = localStorage.getItem("control-panel-theme");
                document.documentElement.setAttribute("data-theme", theme === "light" || theme === "dark" ? theme : preferredTheme());
            } catch (error) {
                document.documentElement.setAttribute("data-theme", preferredTheme());
            }
            try {
                if (localStorage.getItem("control-panel-sidebar") === "collapsed") {
                    document.documentElement.setAttribute("data-sidebar", "collapsed");
                }
            } catch (error) {
                document.documentElement.removeAttribute("data-sidebar");
            }
        })();
    </script>
    <link rel="stylesheet" href="{{ext.appPath}}/micronaut-control-panel/css/dashboard.css">

    <script src="//cdn.jsdelivr.net/npm/jquery@3.6.3/dist/jquery.min.js"></script>
    <script src="{{ext.appPath}}/micronaut-control-panel/js/dashboard.js"></script>
</head>
<body class="cp-body">
<div class="cp-dashboard-provider">
    <aside class="cp-sidebar" id="controlPanelSidebar">
        <div class="cp-sidebar-header">
            <a href="{{ext.controlPanelPath}}" class="cp-brand" aria-label="Micronaut Control Panel home">
                <span class="cp-brand-mark">
                    <img src="{{ext.appPath}}/micronaut-control-panel/img/micronaut-logo-white.svg" alt="" class="cp-brand-image cp-brand-logo cp-brand-image-dark">
                    <img src="{{ext.appPath}}/micronaut-control-panel/img/micronaut-logo-dark.svg" alt="" class="cp-brand-image cp-brand-logo cp-brand-image-light">
                </span>
                <span class="cp-brand-title">Control Panel</span>
            </a>
        </div>

        <div class="cp-sidebar-content">
            <div class="cp-sidebar-group-label">Categories</div>
            <nav class="cp-nav" aria-label="Control panel categories">
                {{#each categories as |category|}}
                    <a href="{{ext.controlPanelPath}}/categories/{{ category.id }}" class="cp-nav-link {{#eq currentCategory.id category.id}}active{{/eq}}" title="{{ category.name }}">
                        <span class="cp-nav-icon">
                            {{#eq category.id "main"}}
                                <img src="{{ext.appPath}}/micronaut-control-panel/img/micronaut-sally.svg" alt="" class="cp-dashboard-icon">
                            {{else}}
                                <i class="{{ category.iconClass }}"></i>
                            {{/eq}}
                        </span>
                        <span class="cp-nav-label">{{ category.name }}</span>
                        <span class="badge badge-secondary">{{ lookup ext.categoryCount category.id }}</span>
                    </a>
                {{/each}}
            </nav>
        </div>

        <div class="cp-sidebar-footer">
            <div class="cp-sidebar-group-label">Application</div>
            <nav class="cp-nav cp-sidebar-section" aria-label="Application">
                <a href="{{ext.controlPanelPath}}" class="cp-nav-link cp-application-link {{#eq currentCategory.id "main"}}active{{/eq}}" title="{{ applicationName }}">
                    <span class="cp-nav-icon cp-application-icon"><i class="fas fa-cube"></i></span>
                    <span class="cp-nav-label">{{ applicationName }}</span>
                    {{#with ext.applicationHealth}}
                        {{#eq status.name 'UP'}}
                            <span class="cp-health-indicator cp-health-up" title="Application health: UP" aria-label="Application health: UP">
                                <i class="fas fa-circle-check"></i>
                            </span>
                        {{/eq}}
                        {{#eq status.name 'DOWN'}}
                            <span class="cp-health-indicator cp-health-down" title="Application health: DOWN" aria-label="Application health: DOWN">
                                <i class="fas fa-circle-exclamation"></i>
                            </span>
                        {{/eq}}
                        {{#eq status.name 'UNKNOWN'}}
                            <span class="cp-health-indicator cp-health-unknown" title="Application health: UNKNOWN" aria-label="Application health: UNKNOWN">
                                <i class="fas fa-circle-question"></i>
                            </span>
                        {{/eq}}
                    {{/with}}
                </a>
            </nav>

            {{#if ext.hasActiveEnvironments}}
                <div class="cp-sidebar-group-label cp-environment-label">Environments</div>
                <div class="cp-environments cp-sidebar-section cp-environment-list" aria-label="Active environments">
                    {{#each ext.activeEnvironments }}
                        <span class="badge cp-environment-tag" title="{{ this }}">{{ this }}</span>
                    {{/each}}
                </div>
            {{/if}}

            {{#if canRefresh}}
                <div class="cp-sidebar-group-label">Application Controls</div>
                <div class="cp-sidebar-actions cp-sidebar-section">
                    <button class="btn btn-outline" id="refreshButton" type="button" data-toggle="modal" data-target="#stopRefreshModal" data-action="refresh" title="{{#if ext.writeAccess.allowed}}Refresh application{{else}}{{ ext.writeAccess.reason }}{{/if}}"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true"{{/unless}}>
                        <i class="fas fa-arrows-rotate"></i>
                        <span>Refresh</span>
                    </button>
                    {{#if canStop}}
                        <button class="btn btn-danger" id="stopButton" type="button" data-toggle="modal" data-target="#stopRefreshModal" data-action="shutdown" title="{{#if ext.writeAccess.allowed}}Stop application{{else}}{{ ext.writeAccess.reason }}{{/if}}"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true"{{/unless}}>
                            <i class="fas fa-stop"></i>
                            <span>Stop</span>
                        </button>
                    {{/if}}
                </div>
            {{else}}
                {{#if canStop}}
                    <div class="cp-sidebar-group-label">Application Controls</div>
                    <div class="cp-sidebar-actions cp-sidebar-section">
                        <button class="btn btn-danger" id="stopButton" type="button" data-toggle="modal" data-target="#stopRefreshModal" data-action="shutdown" title="{{#if ext.writeAccess.allowed}}Stop application{{else}}{{ ext.writeAccess.reason }}{{/if}}"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true"{{/unless}}>
                            <i class="fas fa-stop"></i>
                            <span>Stop</span>
                        </button>
                    </div>
                {{/if}}
            {{/if}}
        </div>
    </aside>

    <button type="button" class="cp-sidebar-backdrop" data-sidebar-close aria-label="Close navigation"></button>

    <div class="cp-sidebar-inset cp-main">
        <header class="cp-site-header cp-header">
            <div class="cp-header-start">
                <button class="btn btn-ghost btn-icon cp-menu-button" data-sidebar-toggle type="button" aria-label="Toggle navigation" aria-expanded="true" title="Toggle sidebar">
                    <svg class="cp-sidebar-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                        <path d="M9 3v18"></path>
                    </svg>
                </button>
                <span class="cp-header-separator" aria-hidden="true"></span>
                <div class="cp-title-block">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            {{#if ext.controlPanel }}
                                {{#eq ext.currentCategory.id "main"}}
                                    <li class="breadcrumb-item">
                                        <a href="{{ext.controlPanelPath}}">
                                            <img src="{{ext.appPath}}/micronaut-control-panel/img/micronaut-sally.svg" alt="" class="cp-dashboard-icon">
                                            Dashboard
                                        </a>
                                    </li>
                                    <li class="breadcrumb-separator" aria-hidden="true">/</li>
                                {{else}}
                                    <li class="breadcrumb-item">
                                        <a href="{{ext.controlPanelPath}}/categories/{{ ext.currentCategory.id }}">
                                            <i class="{{ ext.currentCategory.iconClass }}"></i>
                                            {{ ext.currentCategory.name }}
                                        </a>
                                    </li>
                                    <li class="breadcrumb-separator" aria-hidden="true">/</li>
                                {{/eq}}
                                <li class="breadcrumb-item active" aria-current="page">
                                    {{#if ext.controlPanel.icon}}
                                        <i class="fa {{ ext.controlPanel.icon }}"></i>
                                    {{/if}}
                                    {{{ ext.controlPanel.title }}}
                                    {{#if ext.controlPanel.badge }}
                                        <span class="badge badge-secondary">{{ ext.controlPanel.badge }}</span>
                                    {{/if}}
                                </li>
                            {{else}}
                                {{#eq ext.currentCategory.id "main"}}
                                    <li class="breadcrumb-item active" aria-current="page">
                                        <img src="{{ext.appPath}}/micronaut-control-panel/img/micronaut-sally.svg" alt="" class="cp-dashboard-icon">
                                        {{ ext.currentCategory.name }}
                                    </li>
                                {{else}}
                                    <li class="breadcrumb-item active" aria-current="page">
                                        <i class="{{ ext.currentCategory.iconClass }}"></i>
                                        {{ ext.currentCategory.name }}
                                    </li>
                                {{/eq}}
                            {{/if}}
                        </ol>
                    </nav>
                </div>
            </div>

            <div class="cp-header-actions">
                <button class="btn btn-ghost btn-icon cp-theme-toggle" id="themeToggle" type="button" title="Switch color mode" aria-label="Switch color mode" aria-live="polite">
                    <svg class="cp-theme-icon" xmlns="http://www.w3.org/2000/svg" width="19.2" height="19.2" viewBox="0 0 24 24" aria-hidden="true">
                        <circle class="cp-theme-icon-background" cx="12" cy="12" r="9"></circle>
                        <path class="cp-theme-icon-fill" d="M12 3a9 9 0 0 0 0 18Z"></path>
                        <circle class="cp-theme-icon-ring" cx="12" cy="12" r="9"></circle>
                    </svg>
                    <span class="sr-only">Toggle theme</span>
                </button>
            </div>
        </header>

        <main class="cp-dashboard-main">
            <div class="cp-dashboard-container">
                <div class="cp-dashboard-stack">
                    <div class="alert alert-success" id="globalAlert" role="status" style="display:none;">
                        <h5>
                            <i class="icon fas fa-arrows-rotate"></i>
                            <span id="globalAlertTitle"></span>
                        </h5>
                        <span id="globalAlertMessage"></span>
                    </div>

                    {{> (stringFormat "views/%s" (lower contentView)) }}
                </div>
            </div>
        </main>
    </div>
</div>

<div class="modal fade" id="stopRefreshModal" tabindex="-1" role="dialog" aria-labelledby="stopRefreshModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stopRefreshModalLabel">Confirm</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="stopConfirm"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true" title="{{ ext.writeAccess.reason }}"{{/unless}}>Shutdown</button>
                <button type="button" class="btn btn-warning" id="refreshConfirm"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true" title="{{ ext.writeAccess.reason }}"{{/unless}}>Refresh</button>
                <button type="button" class="btn btn-danger" id="refreshForce"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true" title="{{ ext.writeAccess.reason }}"{{/unless}}>Force refresh</button>
            </div>
        </div>
    </div>
</div>

<script src="//cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.7.0/build/highlight.min.js"></script>
<script src="//cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.7.0/build/languages/properties.min.js"></script>
<script src="//cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.7.0/build/languages/java.min.js"></script>
<script src="//cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.7.0/build/languages/json.min.js"></script>
<script src="//cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.7.0/build/languages/sql.min.js"></script>
<script src="{{ext.appPath}}/micronaut-control-panel/js/editor.bundle.js"></script>
<script src="//cdn.jsdelivr.net/npm/mermaid@9/dist/mermaid.min.js"></script>
<script>
    hljs.highlightAll();
    mermaid.initialize({startOnLoad: false});

    $('#stopRefreshModal').on('show.bs.modal', function (event) {
        var modal = $(this)
        var button = $(event.relatedTarget)
        if (!{{ ext.writeAccess.allowed }} || button.prop('disabled')) {
            event.preventDefault()
            return;
        }
        var action = button.data('action')
        var body = "Refreshing the application will cause all Refreshable beans in the context to be destroyed and re-instantiated upon further requests."
        var confirm = "Are you sure you want to continue?"
        modal.find('#stopConfirm').hide()
        modal.find('#refreshConfirm').show()
        modal.find('#refreshForce').show()
        if (action === 'shutdown') {
            body = "Shutting down the application cannot be undone."
            modal.find('#stopConfirm').show()
            modal.find('#refreshConfirm').hide()
            modal.find('#refreshForce').hide()
        }

        modal.find('.modal-title').text('Confirm application ' + action)
        modal.find('.modal-body').html('<p class="card-text">' + body + '</p><p class="card-text">' + confirm + '</p>')
    })

    $('#stopConfirm').click(function() {
        if (!{{ ext.writeAccess.allowed }} || this.disabled) {
            return;
        }
        $.ajax({
            url: '{{ ext.controlPanelPath }}/application-control-panel-controller/stop',
            type: 'POST',
            success: function(result) {
                $('#stopRefreshModal').modal('hide')
                globalAlertMessageDisplay('Application is shutting down', 'The application is shutting down. Please wait for the server to stop.', 'alert-danger', 'fa-arrows-rotate')
            }
        });
    })

    $('#refreshConfirm').click(function() {
        if (!{{ ext.writeAccess.allowed }} || this.disabled) {
            return;
        }
        $.ajax({
            url: '{{ ext.controlPanelPath }}/application-control-panel-controller/refresh',
            type: 'POST',
            success: function(result) {
                $('#stopRefreshModal').modal('hide')
                globalAlertMessageDisplay('Application refreshed', 'All Refreshable beans have been recreated.', 'alert-success', 'fa-arrows-rotate')
            }
        });
    })

    $('#refreshForce').click(function() {
        if (!{{ ext.writeAccess.allowed }} || this.disabled) {
            return;
        }
        $.ajax({
            url: '{{ ext.controlPanelPath }}/application-control-panel-controller/refresh',
            data: JSON.stringify({force: true}),
            contentType: "application/json; charset=utf-8",
            type: 'POST',
            success: function(result) {
                $('#stopRefreshModal').modal('hide')
                globalAlertMessageDisplay('Application refreshed', 'All Refreshable beans have been recreated regardless of environment changes.', 'alert-success', 'fa-arrows-rotate')
            }
        });
    })
</script>
</body>
</html>
