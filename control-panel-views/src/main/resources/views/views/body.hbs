{{#with controlPanel.body }}
    {{#unless enabled}}<p class="card-text"><span class="badge badge-destructive">views disabled</span></p>{{/unless}}
    <p class="card-text">{{routes.size}} view routes, templates in <code>{{folder}}</code>.</p>
    {{#each renderers as |renderer|}}
        <p class="card-text"><code class="cp-table-code">{{renderer.type}}</code></p>
    {{else}}
        <p class="card-text text-muted">No views renderer is available.</p>
    {{/each}}
{{/with}}
