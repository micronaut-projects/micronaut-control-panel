{{#with controlPanel.detailedBody }}
<div class="cp-dashboard-stack">
    {{#each clients as |client|}}
    <div class="card card-light">
        <div class="card-header">
            <h3 class="card-title"><code>{{client.name}}</code> <span class="text-muted">{{client.driver}} driver</span></h3>
            <div class="card-tools">
                {{#if client.connected}}<span class="badge badge-secondary">connected</span>{{else}}<span class="badge badge-destructive">not connected</span>{{/if}}
            </div>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">Cluster</dt>
                <dd class="col-sm-10">{{client.clusterType}}</dd>
                <dt class="col-sm-2">Servers</dt>
                <dd class="col-sm-10">
                    {{#each client.servers as |server|}}
                        <div>
                            <code>{{server.address}}</code>
                            <span class="badge {{#if server.connected}}badge-secondary{{else}}badge-destructive{{/if}}">{{server.type}}</span>
                            {{#if server.replicaSet}}<span class="text-muted">replica set {{server.replicaSet}}</span>{{/if}}
                            {{#if server.roundTripMillis}}<span class="text-muted">{{server.roundTripMillis}} ms</span>{{/if}}
                        </div>
                    {{else}}
                        <span class="text-muted">none</span>
                    {{/each}}
                </dd>
            </dl>
            {{#if client.error}}
                <p class="card-text text-muted">{{client.error}}</p>
            {{/if}}
            {{#if client.databases}}
            <div class="cp-data-table" data-filter-table data-filter-table-label="database" data-filter-table-label-plural="databases">
                <div class="cp-data-table-toolbar">
                    <div class="cp-data-table-summary" data-filter-table-summary>{{client.databases.size}} databases</div>
                    <div class="cp-data-table-search">
                        <input type="search" class="form-control" data-filter-table-search placeholder="Search databases or collections" aria-label="Search databases of {{client.name}}">
                    </div>
                </div>
                <div class="cp-data-table-container">
                    <table class="table cp-data-table-table cp-mongodb-table">
                        <thead>
                        <tr>
                            <th>Database</th>
                            <th class="cp-mongodb-size">Size on disk</th>
                            <th>Collections</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#each client.databases as |database|}}
                            <tr data-filter-table-row>
                                <td><code class="cp-table-code">{{database.name}}</code></td>
                                <td class="cp-mongodb-size">{{database.sizeOnDisk}}</td>
                                <td>
                                    {{#if database.collections}}
                                        {{#each database.collections as |collection|}}
                                            <div>
                                                <code class="cp-table-code">{{collection.name}}</code>
                                                {{#if collection.documentsLabel}}<span class="text-muted">{{collection.documentsLabel}}</span>{{/if}}
                                                {{#if (eq collection.type 'collection')}}{{else}}<span class="badge badge-outline">{{collection.type}}</span>{{/if}}
                                            </div>
                                        {{/each}}
                                        {{#if database.collectionsTruncated}}<div class="text-muted">Only the first 100 are listed.</div>{{/if}}
                                    {{else}}
                                        <span class="text-muted">none</span>
                                    {{/if}}
                                </td>
                            </tr>
                        {{/each}}
                        <tr data-filter-table-empty hidden>
                            <td class="cp-data-table-empty-cell" colspan="3">No databases match your search.</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            {{#if client.databasesTruncated}}<p class="card-text text-muted">Only the first 50 databases are listed.</p>{{/if}}
            {{/if}}
        </div>
    </div>
    {{else}}
    <div class="card card-light">
        <div class="card-body">
            <p class="card-text text-muted">There are no MongoDB clients. Configure one with <code>mongodb.uri</code> or under <code>mongodb.servers</code>.</p>
        </div>
    </div>
    {{/each}}
</div>
{{/with}}
