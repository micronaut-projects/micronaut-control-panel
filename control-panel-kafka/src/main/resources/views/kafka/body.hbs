<div class="list-group">
  {{#each body.listeners}}
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <span><i class="fa-solid fa-ear-listen me-2"></i>{{class}}</span>
      <span class="badge bg-secondary">Listener</span>
    </div>
  {{/each}}
  {{#each body.clients}}
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <span><i class="fa-solid fa-paper-plane me-2"></i>{{class}}</span>
      <span class="badge bg-info">Client</span>
    </div>
  {{/each}}
</div>

<pre class="mermaid" style="display:none;">{{ body.mermaid }}</pre>
