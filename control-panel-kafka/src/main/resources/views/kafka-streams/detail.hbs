<h5>Kafka Streams Topology</h5>
<pre id="kafkaStreamsMermaidCode" style="display:none;">{{{ body.mermaid }}}</pre>
<div id="kafkaStreamsDiagram" class="mermaid"></div>

<script>
  (function(){
    var pre = document.getElementById('kafkaStreamsMermaidCode');
    var container = document.getElementById('kafkaStreamsDiagram');
    if (!pre || !container) return;
    var code = (pre.textContent || pre.innerText || '').replace(/\r\n/g, '\n').trimStart();
    var renderId = 'kafkaStreams_' + Math.random().toString(36).substring(2);

    function doRender() {
      if (!code) {
        container.textContent = 'No topology detected';
        return true;
      }
      if (window.mermaid && typeof window.mermaid.render === 'function') {
        try {
          window.mermaid.render(renderId, code, function(svgCode) {
            container.innerHTML = svgCode;
          });
          return true;
        } catch (e) {}
      }
      if (window.mermaid) {
        container.innerText = code;
        container.className = 'mermaid';
        try { window.mermaid.init(undefined, container); } catch(e) {}
        return true;
      }
      return false;
    }

    var attempts = 0;
    (function retry(){
      if (doRender() || attempts++ > 30) return;
      setTimeout(retry, 100);
    })();
  })();
</script>
