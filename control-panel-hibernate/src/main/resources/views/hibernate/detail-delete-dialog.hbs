    <div class="modal fade cp-dialog" id="hibernateDeleteConfirmModal" tabindex="-1" role="dialog" aria-labelledby="hibernateDeleteConfirmModalLabel" aria-describedby="hibernateDeleteConfirmModalDescription" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content cp-dialog-content">
                <div class="modal-header cp-dialog-header">
                    <div class="cp-dialog-heading">
                        <h5 class="modal-title cp-dialog-title" id="hibernateDeleteConfirmModalLabel">
                            <i class="fa fa-trash"></i>
                            <span data-hibernate-confirm-title>Confirm action</span>
                        </h5>
                        <p class="cp-dialog-description" id="hibernateDeleteConfirmModalDescription" data-hibernate-confirm-description></p>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" title="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 6 6 18"></path>
                            <path d="m6 6 12 12"></path>
                        </svg>
                    </button>
                </div>
                <div class="modal-body" data-hibernate-confirm-body></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="hibernateDeleteConfirm"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true" title="{{ ext.writeAccess.reason }}"{{/unless}}>Confirm</button>
                </div>
            </div>
        </div>
    </div>
