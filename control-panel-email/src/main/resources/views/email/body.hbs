{{#with controlPanel.body }}
    {{#each senders as |sender|}}
        <p class="card-text"><code>{{sender.name}}</code> <span class="card-description">{{sender.provider}}</span></p>
    {{else}}
        <p class="card-text card-description">There are no email senders.</p>
    {{/each}}
    <p class="card-text card-description">{{#if from}}Default sender {{from}}.{{else}}No default sender is configured.{{/if}}</p>
{{/with}}
