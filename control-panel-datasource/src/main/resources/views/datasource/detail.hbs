{{#with controlPanel.body }}

    <div class="cp-datasource-layout cp-datasource-page">
            <aside class="card card-light cp-schema-sidebar" aria-label="Database tables">
                <div class="card-header cp-schema-sidebar-header">
                    <div class="cp-schema-sidebar-heading">
                        <h3 class="card-title">Tables</h3>
                        <span class="badge badge-secondary">{{ tables.size }}</span>
                    </div>
                    <button type="button" class="btn btn-primary btn-icon" id="openErModal" title="Show ER diagram" data-dialog-target="#erDiagramDialog" aria-label="Show ER diagram">
                        <i class="fas fa-diagram-project"></i>
                    </button>
                </div>
                <div class="card-body cp-schema-sidebar-content">
                    {{#if tables}}
                        <div class="cp-schema-tree" data-schema-tree>
                            {{#each tables as |table|}}
                                <details class="cp-schema-tree-item" open>
                                    <summary class="cp-schema-tree-button" data-table-name="{{ table.name }}" title="{{ table.name }}">
                                        <svg class="cp-tree-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m9 18 6-6-6-6"></path>
                                        </svg>
                                        <i class="fas fa-table cp-tree-icon cp-tree-icon-table" aria-hidden="true"></i>
                                        <span class="cp-schema-tree-label">{{ table.name }}</span>
                                    </summary>
                                    <div class="cp-schema-tree-sub">
                                        {{#each table.columns as |col|}}
                                            <button type="button" class="cp-schema-tree-button cp-schema-tree-leaf" title="{{ col.name }} {{ col.displayType }}">
                                                <span class="cp-tree-spacer" aria-hidden="true"></span>
                                                <i class="fas fa-table-columns cp-tree-icon cp-tree-icon-column" aria-hidden="true"></i>
                                                <span class="cp-schema-tree-label">{{ col.name }}</span>
                                                <span class="cp-schema-column-type">{{ col.displayType }}</span>
                                                {{#if col.isPrimaryKey}}
                                                    <span class="badge badge-secondary">PK</span>
                                                {{/if}}
                                                {{#if col.isForeignKey}}
                                                    <span class="badge badge-secondary">FK</span>
                                                {{/if}}
                                            </button>
                                        {{/each}}
                                    </div>
                                </details>
                            {{/each}}
                        </div>
                    {{else}}
                        <div class="cp-data-table-empty">No tables found.</div>
                    {{/if}}
                </div>
                <div class="card-footer cp-schema-sidebar-footer">
                    <code class="cp-table-code">{{ dataSourceInfo.name }}</code>
                    <span class="badge badge-secondary">{{ dataSourceInfo.type }}</span>
                </div>
            </aside>
            <div class="cp-datasource-content">
                <div class="card card-light cp-sql-card">
                    <div class="card-header">
                        <div class="cp-card-heading">
                            <span class="cp-card-icon">
                                <i class="fas fa-terminal"></i>
                            </span>
                            <h3 class="card-title">SQL query</h3>
                        </div>
                        <div class="card-tools">
                            <button type="button" class="btn btn-success btn-sm" id="executeQuery" title="{{#if ext.writeAccess.allowed}}Execute query (Cmd+Enter / Ctrl+Enter){{else}}{{ ext.writeAccess.reason }}{{/if}}"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true"{{/unless}}>
                                <i class="fas fa-play"></i>
                                Run
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="sql-console">
                        </div>
                    </div>
                </div>
                <div class="card card-light cp-query-results-card">
                    <div class="card-header">
                        <div class="cp-card-heading">
                            <span class="cp-card-icon">
                                <i class="fas fa-table-list"></i>
                            </span>
                            <h3 class="card-title">Query results</h3>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="queryResultsContainer" class="cp-data-table">
                            <div class="cp-query-state">
                                <i class="fas fa-table-list" aria-hidden="true"></i>
                                <strong>Run a query to see results.</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    <!-- Hidden Mermaid ER code source -->
    <pre id="mermaidErCode" style="display:none;">{{{ mermaidEr }}}</pre>

    <!-- ER Diagram Dialog -->
    <div class="modal fade cp-dialog" id="erDiagramDialog" tabindex="-1" role="dialog" aria-labelledby="erDiagramDialogTitle" aria-describedby="erDiagramDialogDescription" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content cp-dialog-content">
                <div class="modal-header cp-dialog-header">
                    <div class="cp-dialog-heading">
                        <h5 class="modal-title cp-dialog-title" id="erDiagramDialogTitle">
                            <i class="fas fa-diagram-project"></i> Entity Relationship Diagram
                        </h5>
                        <p class="cp-dialog-description" id="erDiagramDialogDescription">Database tables and relationships rendered from the current datasource metadata.</p>
                    </div>
                    <button type="button" class="close" data-dialog-close aria-label="Close" title="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 6 6 18"></path>
                            <path d="m6 6 12 12"></path>
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="erDiagramContainer" class="mermaid"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dialog-close>Close</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(function () {
            $('[data-schema-tree]').on('click', '[data-table-name]', function () {
                select(this.getAttribute('data-table-name'));
            });
        });
        function select(tableName) {
            const cm = window.codemirror;
            if (!cm || !cm.view) {
                return;
            }
            const view = cm.view;
            const newDoc = "SELECT * FROM " + tableName + "\n\n";
            view.dispatch({
                changes: { from: 0, to: view.state.doc.length, insert: newDoc }
            });
        }

        // Initialize CodeMirror editor dynamically after schema loads
        $(function() {
            const type = "{{dataSourceInfo.type}}";
            const ds = "{{ controlPanel.title }}";
            const schemaUrl = "{{ ext.controlPanelPath }}/datasource-control-panel-controller/" + encodeURIComponent(ds) + "/schema.js";
            const cm = window.codemirror;

            function initEditor() {
                if (cm.schema !== undefined && cm.defaultSchema !== undefined) {
                    const schemaConfig = { schema: cm.schema, defaultSchema: cm.defaultSchema };
                    const extensions = cm.getSQLExtensions(type, schemaConfig, {
                        executeQuery: function (view) {
                            if (!{{ ext.writeAccess.allowed }}) {
                                renderQueryState('Query execution disabled', '{{ ext.writeAccess.reason }}', 'error');
                                return true;
                            }
                            executeSqlQuery(view);
                            return true;
                        }
                    });
                    const state = cm.EditorState.create({
                        doc: "\n\n",
                        extensions: extensions
                    });
                    const view = new cm.EditorView({
                        state,
                        parent: document.querySelector("#sql-console")
                    });
                    cm.view = view;
                }
            }

            // Dynamically load schema script with onload
            const script = document.createElement('script');
            script.src = schemaUrl;
            script.onload = function() {
                initEditor();
            };
            script.onerror = function() {
                // Fallback init without schema
                const schemaConfig = {};
                const extensions = cm.getSQLExtensions(type, schemaConfig, {
                        executeQuery: function (view) {
                            if (!{{ ext.writeAccess.allowed }}) {
                                renderQueryState('Query execution disabled', '{{ ext.writeAccess.reason }}', 'error');
                                return true;
                            }
                            executeSqlQuery(view);
                            return true;
                    }
                });
                const state = cm.EditorState.create({
                    doc: "\n\n",
                    extensions: extensions
                });
                const view = new cm.EditorView({
                    state,
                    parent: document.querySelector("#sql-console")
                });
                cm.view = view;
            };
            document.head.appendChild(script);

            // Fallback timeout if onload doesn't trigger (e.g., script executes but properties not set)
            setTimeout(() => {
                if (cm.schema === undefined) {
                    initEditor(); // Try to init if now available
                }
            }, 2000);

            $(document).on('keydown', function(e) {
                if (isQueryExecuteShortcut(e) && $(e.target).closest('.cm-editor').length === 0) {
                    e.preventDefault();
                    executeSqlQuery();
                }
            });
        });

        // Render Mermaid ER diagram when the dialog is shown
        $('#erDiagramDialog').on('shown.bs.modal', function () {
            let code = $('#mermaidErCode').text();
            // Normalize line endings and trim, Mermaid parser is sensitive to stray characters
            code = code.replace(/\r\n/g, '\n').trimStart();

            const container = document.getElementById('erDiagramContainer');
            container.innerHTML = '';
            // Unique id each time to avoid collisions if reopened
            const renderId = 'erDiagramSvg_' + Date.now();
            if (window.mermaid && typeof window.mermaid.render === 'function') {
                window.mermaid.render(renderId, code, (svgCode) => {
                    container.innerHTML = svgCode;
                }, container);
            } else if (window.mermaid) {
                // Fallback: let Mermaid init process the container if render API not present
                const pre = document.createElement('div');
                pre.className = 'mermaid';
                pre.textContent = code;
                container.appendChild(pre);
                try {
                    window.mermaid.init(undefined, container);
                } catch (e) {
                    console.error('Mermaid initialization failed', e);
                }
            }
        }).on('hide.bs.modal', function () {
            // Clean up to reduce memory usage on repeated openings
            document.getElementById('erDiagramContainer').innerHTML = '';
        });

        var queryTableState = {
            sql: '',
            page: 0,
            pageSize: 10,
            draw: 0
        };

        function escapeHtml(value) {
            return $('<div>').text(value == null ? '' : String(value)).html();
        }

        function resolveTotal(resp, rows) {
            if (resp && typeof resp.recordsFiltered === 'number') {
                return resp.recordsFiltered;
            }
            if (resp && typeof resp.recordsTotal === 'number') {
                return resp.recordsTotal;
            }
            return rows.length;
        }

        function renderQueryState(title, message, variant) {
            const icon = variant === 'error' ? 'fa-circle-exclamation' : 'fa-table-list';
            const extraClass = variant === 'error' ? ' cp-query-state-error' : '';
            const description = message ? '<p>' + escapeHtml(message) + '</p>' : '';
            $('#queryResultsContainer').html(
                '<div class="cp-query-state' + extraClass + '">' +
                '<i class="fas ' + icon + '" aria-hidden="true"></i>' +
                '<strong>' + escapeHtml(title) + '</strong>' +
                description +
                '</div>'
            );
        }

        function renderQueryTable(resp) {
            const cols = resp && resp.cols ? resp.cols : [];
            const rows = resp && resp.data ? resp.data : [];
            const total = resolveTotal(resp, rows);
            const pageSize = queryTableState.pageSize;
            const pageCount = Math.max(1, Math.ceil(total / pageSize));
            const page = Math.min(queryTableState.page, pageCount - 1);
            queryTableState.page = page;

            const $container = $('#queryResultsContainer');
            if (cols.length === 0) {
                renderQueryState('No columns returned.', '', 'empty');
                return;
            }

            const start = total === 0 ? 0 : page * pageSize + 1;
            const end = Math.min(total, page * pageSize + rows.length);
            const isPreviousDisabled = page <= 0 ? ' disabled' : '';
            const isNextDisabled = page >= pageCount - 1 ? ' disabled' : '';

            const thead = '<thead><tr>' + cols.map(function (col) {
                return '<th>' + escapeHtml(col) + '</th>';
            }).join('') + '</tr></thead>';

            const tbody = rows.length === 0
                ? '<tbody><tr><td class="cp-data-table-empty-cell" colspan="' + cols.length + '">No results.</td></tr></tbody>'
                : '<tbody>' + rows.map(function (row) {
                    return '<tr>' + cols.map(function (_, index) {
                        return '<td>' + escapeHtml(row[index]) + '</td>';
                    }).join('') + '</tr>';
                }).join('') + '</tbody>';

            const tableHtml =
                '<div class="cp-data-table-toolbar">' +
                '<div class="cp-data-table-summary">' + escapeHtml(total) + ' row' + (total === 1 ? '' : 's') + '</div>' +
                '<label class="cp-data-table-page-size">Rows per page ' +
                '<select data-query-page-size>' +
                '<option value="10"' + (pageSize === 10 ? ' selected' : '') + '>10</option>' +
                '<option value="25"' + (pageSize === 25 ? ' selected' : '') + '>25</option>' +
                '<option value="50"' + (pageSize === 50 ? ' selected' : '') + '>50</option>' +
                '</select></label>' +
                '</div>' +
                '<div class="cp-data-table-container">' +
                '<table id="queryResults" class="table cp-data-table-table">' + thead + tbody + '</table>' +
                '</div>' +
                '<div class="cp-data-table-footer">' +
                '<div class="cp-data-table-summary">Showing ' + escapeHtml(start) + '-' + escapeHtml(end) + ' of ' + escapeHtml(total) + '</div>' +
                '<div class="cp-data-table-pagination">' +
                '<span class="cp-data-table-page">Page ' + escapeHtml(page + 1) + ' of ' + escapeHtml(pageCount) + '</span>' +
                '<button type="button" class="btn btn-outline btn-sm" data-query-page="previous"' + isPreviousDisabled + '>Previous</button>' +
                '<button type="button" class="btn btn-outline btn-sm" data-query-page="next"' + isNextDisabled + '>Next</button>' +
                '</div>' +
                '</div>';

            $container.html(tableHtml);
        }

        function loadQueryPage() {
            if (!{{ ext.writeAccess.allowed }}) {
                renderQueryState('Query execution disabled', '{{ ext.writeAccess.reason }}', 'error');
                return;
            }
            const controlPanelPath = '{{ ext.controlPanelPath }}';
            const ds = '{{ controlPanel.title }}';
            const url = controlPanelPath + '/datasource-control-panel-controller/' + encodeURIComponent(ds) + '/query';

            globalAlertMessageClear();
            $.ajax({
                url: url,
                type: 'POST',
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({
                    sql: queryTableState.sql,
                    start: queryTableState.page * queryTableState.pageSize,
                    length: queryTableState.pageSize,
                    draw: ++queryTableState.draw
                })
            }).done(function(resp) {
                if (resp && resp.error) {
                    renderQueryState('Query failed', resp.error, 'error');
                    return;
                }
                renderQueryTable(resp);
            }).fail(function(xhr) {
                const err = (xhr.responseJSON && xhr.responseJSON.error) ? xhr.responseJSON.error : 'Query failed';
                renderQueryState('Query failed', err, 'error');
            });
        }

        function initQueryTable(sql) {
            queryTableState.sql = sql;
            queryTableState.page = 0;
            queryTableState.draw = 0;
            loadQueryPage();
        }

        $('#queryResultsContainer').on('click', '[data-query-page]', function () {
            const direction = $(this).data('query-page');
            queryTableState.page += direction === 'next' ? 1 : -1;
            queryTableState.page = Math.max(0, queryTableState.page);
            loadQueryPage();
        }).on('change', '[data-query-page-size]', function () {
            queryTableState.pageSize = Number($(this).val());
            queryTableState.page = 0;
            loadQueryPage();
        });

        function isQueryExecuteShortcut(event) {
            return (event.metaKey || event.ctrlKey) && event.key === 'Enter' && !event.shiftKey && !event.altKey;
        }

        function editorSql(view) {
            const editorView = view || (window.codemirror && window.codemirror.view) || null;
            const doc = editorView && editorView.state && editorView.state.doc ? editorView.state.doc : null;
            return doc ? String(doc.toString()).trim() : '';
        }

        function executeSqlQuery(view) {
            try {
                const sql = editorSql(view);
                if (!sql) {
                    renderQueryState('SQL must not be empty', 'Type a query in the SQL editor before running it.', 'error');
                    return;
                }
                initQueryTable(sql);
            } catch (e) {
                renderQueryState('Cannot read SQL from editor', 'The query editor is not ready yet. Try again after the page finishes loading.', 'error');
            }
        }

        // Hook Play button
        $('#executeQuery').on('click', function() {
            if (this.disabled) {
                return;
            }
            executeSqlQuery();
        });
    </script>

{{/with}}
