<div class="card card-light cp-pool-status-card">
    <div class="card-header">
        <div class="cp-card-heading">
            <span class="cp-card-icon">
                <i class="fas fa-gauge-high" aria-hidden="true"></i>
            </span>
            <div class="cp-card-header-text">
                <h3 class="card-title">{{ provider }}</h3>
                <p class="card-description">{{ poolName }}</p>
            </div>
        </div>
        <div class="card-tools">
            <button type="button" class="btn btn-outline btn-sm btn-icon" data-pool-status-refresh aria-label="Refresh connection pool status" title="Refresh connection status">
                <i class="fas fa-rotate" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="cp-pool-status-layout">
            <div class="cp-pool-status-chart" aria-label="Connection pool usage">
                <div class="cp-pool-status-heading">
                    <span>Connection status</span>
                    <strong>{{ stats.usageLabel }}</strong>
                </div>
                <div class="cp-pool-usage-bar">
                    <span class="cp-pool-usage-segment cp-pool-usage-active" style="width: {{ stats.activeWidth }};" title="Active connections"></span>
                    <span class="cp-pool-usage-segment cp-pool-usage-idle" style="width: {{ stats.idleWidth }};" title="Idle connections"></span>
                    <span class="cp-pool-usage-segment cp-pool-usage-remaining" style="width: {{ stats.remainingWidth }};" title="Remaining capacity"></span>
                </div>
                <div class="cp-pool-usage-legend">
                    <span><i class="cp-pool-legend-dot cp-pool-legend-active" aria-hidden="true"></i>Active</span>
                    <span><i class="cp-pool-legend-dot cp-pool-legend-idle" aria-hidden="true"></i>Idle</span>
                    <span><i class="cp-pool-legend-dot cp-pool-legend-remaining" aria-hidden="true"></i>Remaining</span>
                </div>
            </div>

            <div class="cp-pool-metrics-grid">
                <div class="cp-pool-metric">
                    <span>Active</span>
                    <strong>{{ stats.active }}</strong>
                </div>
                <div class="cp-pool-metric">
                    <span>Idle</span>
                    <strong>{{ stats.idle }}</strong>
                </div>
                <div class="cp-pool-metric">
                    <span>Total</span>
                    <strong>{{ stats.total }}</strong>
                </div>
                <div class="cp-pool-metric">
                    <span>Max</span>
                    <strong>{{ stats.max }}</strong>
                </div>
                <div class="cp-pool-metric">
                    <span>Min</span>
                    <strong>{{ stats.min }}</strong>
                </div>
                <div class="cp-pool-metric">
                    <span>Waiting</span>
                    <strong>{{ stats.awaiting }}</strong>
                </div>
            </div>
        </div>
    </div>
</div>
