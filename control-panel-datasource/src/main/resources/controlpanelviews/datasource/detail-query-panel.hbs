<section class="tabs-panel cp-datasource-query-panel" id="datasourceQueryTab" role="tabpanel" data-tabs-panel="query" hidden>
    <div class="cp-datasource-query-layout">
        <div class="card card-light cp-sql-card">
            <div class="card-header">
                <div class="cp-card-heading">
                    <span class="cp-card-icon">
                        <i class="fas fa-terminal" aria-hidden="true"></i>
                    </span>
                    <h3 class="card-title">SQL query</h3>
                </div>
                <div class="card-tools">
                    <button type="button" class="btn btn-success btn-sm" id="executeQuery" title="{{#if ext.writeAccess.allowed}}Execute query (Cmd+Enter / Ctrl+Enter){{else}}{{ ext.writeAccess.reason }}{{/if}}"{{#unless ext.writeAccess.allowed}} disabled aria-disabled="true"{{/unless}}>
                        <i class="fas fa-play" aria-hidden="true"></i>
                        Run
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div id="sql-console"></div>
            </div>
        </div>

        <div class="cp-query-layout-splitter" id="queryLayoutSplitter" role="separator" aria-orientation="horizontal" aria-label="Resize SQL query and query results" aria-valuemin="15" aria-valuemax="80" aria-valuenow="15" tabindex="0" title="Drag to resize query editor"></div>

        <div class="card card-light cp-query-results-card">
            <div class="card-header">
                <div class="cp-card-heading">
                    <span class="cp-card-icon">
                        <i class="fas fa-table-list" aria-hidden="true"></i>
                    </span>
                    <h3 class="card-title">Query results</h3>
                </div>
                <div class="card-tools">
                    <label class="cp-data-table-page-size cp-query-header-page-size">Rows per page
                        <select data-query-page-size disabled>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </label>
                </div>
            </div>
            <div class="card-body">
                <div id="queryResultsContainer" class="cp-data-table">
                    {{#if ext.writeAccess.allowed}}
                        <div class="cp-query-state">
                            <i class="fas fa-table-list" aria-hidden="true"></i>
                            <strong>Run a query to see results.</strong>
                        </div>
                    {{else}}
                        <div class="cp-query-state cp-query-state-error">
                            <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                            <strong>Query execution disabled</strong>
                            <p>{{ ext.writeAccess.reason }}</p>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</section>

{{> "controlpanelviews/datasource/detail-query-scripts" }}
