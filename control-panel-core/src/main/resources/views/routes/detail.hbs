{{#with controlPanel.body }}
    <div class="cp-dashboard-stack">
        <div class="cp-detail-section-heading">
            <div>
                <h3 class="cp-detail-section-title">Application routes</h3>
            </div>
            {{#if openApiViewerUri}}
                <a href="{{openApiViewerUri}}" target="_blank" rel="nofollow noopener noreferrer" class="btn btn-secondary btn-sm" title="Open {{openApiViewerLabel}} in a new window">
                    <i class="si si-swagger"></i>
                    Open {{openApiViewerLabel}}
                    <i class="fas fa-arrow-up-right-from-square"></i>
                </a>
            {{/if}}
        </div>
        <div class="cp-detail-card-grid">
            {{#each appRoutes as |routes|}}
                {{> "views/routes/routes" parameter=routes}}
            {{/each}}
        </div>

        <div class="cp-detail-section-heading">
            <h3 class="cp-detail-section-title">Micronaut Framework routes</h3>
        </div>
        <div class="cp-detail-card-grid">
            {{#each micronautRoutes as |routes|}}
                {{> "views/routes/routes" parameter=routes}}
            {{/each}}
        </div>
    </div>
{{/with}}
