{{#with controlPanel.body }}
    <p class="card-text">
        {{totalRoutes}} routes loaded.
    </p>

    {{#if openApiViewerUri}}
        <p class="card-text">
            <a class="btn btn-secondary w-100" href="{{openApiViewerUri}}" target="_blank" rel="nofollow noopener noreferrer" role="button" title="Open {{openApiViewerLabel}} in a new window">
                <i class="si si-swagger si--color"></i>
                Open {{openApiViewerLabel}}
                <i class="fas fa-arrow-up-right-from-square"></i>
            </a>
        </p>
    {{/if}}
{{/with}}
